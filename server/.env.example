# Required for persistent production storage. Use a managed PostgreSQL database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PGSSL=true

# Set to your deployed frontend origin(s), comma-separated. Avoid * in production.
API_ALLOWED_ORIGINS=https://your-buildtrack.vercel.app,http://localhost:5173
PORT=3001

# Optional: enables generative BuildTrack AI. Keep this secret on the backend only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
